---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../site-config";
const channel = siteConfig.socialLinks.find(link => link.platform === "youtube")!.href;
---
<BaseLayout title="About Alpha Bravo Media | Meet Ayoub" description="Meet Ayoub, the creator behind Alpha Bravo Media's video guides, DaVinci Resolve workflows, tools, and equipment notes.">
  <section class="proto-hero channel-copy"><p class="proto-byline">About Alpha Bravo Media</p><h1>Behind the frame,<br /><em>meet Ayoub.</em></h1><p>I'm Ayoub, based in {siteConfig.locationLabel}. Alpha Bravo Media is where I share video guides, editing workflows, tools, and equipment notes.</p><p>The articles cover practical questions from the creative process, including exposure, false color, and managing finished projects in DaVinci Resolve.</p><div class="proto-actions"><a class="channel-button channel-button-primary" href={channel}>Watch on YouTube ↗</a><a class="channel-button" href="/blog">Read the articles</a></div></section>
</BaseLayout>

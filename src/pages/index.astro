---
import BaseLayout from "../layouts/BaseLayout.astro";
import RevampPrototype from "../components/RevampPrototype";
import { getCollection } from "astro:content";
import { siteConfig } from "../site-config";
import lutImage from "../content/blog/false-color-lut-generator/LUT Example.jpg";
const base = import.meta.env.BASE_URL;
const channel = siteConfig.socialLinks.find(link => link.platform === "youtube")!.href;
const articles = (await getCollection("blog")).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).map(article => ({
  title: article.data.title, description: article.data.description, href: `${base}blog/${article.id.replace(/\/index$/, "")}`,
  date: article.data.pubDate.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" }),
}));
const showPrototype = import.meta.env.DEV && Astro.url.searchParams.get("prototype") === "revamp";
const variant = Astro.url.searchParams.get("variant");
const initialVariant = variant === "B" || variant === "C" ? variant : "A";
---
{showPrototype ? <html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Alpha Bravo Media | Homepage prototype</title></head><body><RevampPrototype articles={articles} image={lutImage.src} initialVariant={initialVariant} client:load /></body></html> :
<BaseLayout title="Alpha Bravo Media | Video guides, tools and gear" description="Practical video guides, DaVinci Resolve workflows, exposure tools, and equipment notes from Ayoub at Alpha Bravo Media.">
  <section class="proto-hero proto-editorial">
    <div><p class="proto-byline">Video, editing &amp; the creative process</p><h1>Make something<br /><em>worth watching.</em></h1><p class="proto-intro">A journal for curious creators. Practical video guides, useful tools, and notes on the gear I use.</p><div class="proto-actions"><a class="channel-button channel-button-primary" href={channel}>Watch on YouTube ↗</a><a class="channel-button" href="#notes">Explore the guides ↓</a></div></div>
    <a class="proto-hero-image" href={`${base}blog/false-color-lut-generator`}><img src={lutImage.src} width={lutImage.width} height={lutImage.height} alt="An exposure study from the False Color LUT Builder guide" fetchpriority="high" /><div><span>From the journal</span><h3>A better way to see exposure.</h3></div></a>
  </section>
  <section id="notes" class="proto-notes proto-section"><div class="proto-section-heading"><h2>Notes from<br />the edit.</h2><p>Workflows, experiments, and things worth sharing. Written by Ayoub.</p><a href={`${base}blog`}>All articles ↗</a></div><div class="proto-article-list">{articles.map(article => <a class="proto-article" href={article.href}><span>{article.date}</span><div><h3>{article.title}</h3><p>{article.description}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
  <section class="proto-section"><div class="proto-resource-intro"><h2>Open the toolbox.</h2><p>Useful tools, practical guides, and the equipment behind the videos.</p></div><div class="proto-resource-grid">
    <a class="proto-resource proto-lut" href={`${base}blog/false-color-lut-generator`}><img src={lutImage.src} width={lutImage.width} height={lutImage.height} alt="False color view used to evaluate exposure" loading="lazy" /><div><span>Exposure tool</span><h3>See your exposure<br />in a different light.</h3><p>The False Color LUT Builder and its instructions.</p></div></a>
    <a class="proto-resource proto-guide" href={`${base}blog/davinci-resolve-media-management-archive-workflow`}><span>DaVinci Resolve</span><h3>Keep the project.<br />Lose the clutter.</h3><p>A practical guide to archiving your finished edits.</p></a>
    <a class="proto-resource proto-gear" href={`${base}gear`}><span>Equipment notes</span><h3>What's in<br />the kit?</h3><p>Cameras, audio, and the small things that make a difference.</p></a>
    <a class="proto-resource proto-video" href={`${base}resources`}><span>Tools &amp; guides</span><h3>Find your<br />next workflow.</h3><p>Explore the resources behind the articles.</p></a>
  </div><p class="proto-disclosure">Some gear links are affiliate links. I may earn a commission from qualifying purchases.</p></section>
  <section class="proto-watch proto-section"><p>Keep exploring.</p><h2>See you in<br /><em>the next video.</em></h2><a class="channel-button channel-button-primary" href={channel}>Watch Alpha Bravo Media ↗</a></section>
</BaseLayout>}

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../site-config";
import ArticleReadingTools from "../../components/ArticleReadingTools.astro";
import ArticleExtras from "../../components/ArticleExtras.astro";
import "../../styles/article-reader.css";
import "../../styles/typeset.css";
import "../../styles/blog.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(heading => heading.depth === 2 && heading.slug !== "footnote-label");
const contents = sections.map(heading => {
  const start = headings.indexOf(heading) + 1;
  const next = headings.findIndex((item, index) => index >= start && item.depth === 2);
  return { ...heading, children: headings.slice(start, next < 0 ? undefined : next).filter(item => item.depth === 3) };
});

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const articleOgImage = post.data.image?.src ??
  (post.data.youtubeId
    ? `https://img.youtube.com/vi/${post.data.youtubeId}/maxresdefault.jpg`
    : "/alpha-bravo-logo.svg");
---

<BaseLayout
  title={`${post.data.title} | Alpha Bravo Media`}
  description={post.data.description}
  ogImage={articleOgImage}
  ogImageAlt={post.data.title}
  ogType="article"
  author={siteConfig.founderName}
  publishedTime={post.data.pubDate.toISOString()}
>
  <ArticleReadingTools />
  <ArticleExtras />
  <article
    data-pagefind-body
    class="site-section-hero article-reader site-shell--article"
    itemscope
    itemtype="https://schema.org/Article"
  >
    <span data-pagefind-meta="type" class="sr-only">Blog Post</span>

    <div class:list={["site-shell article-page--reader", { "has-contents": sections.length >= 2 }]}>
      <a href={`${base}blog`} class="site-link inline-flex items-center gap-2 text-sm">
        <Icon name="mdi:arrow-left" class="h-4 w-4" />
        Back to Blog
      </a>

      <header class="site-page-header mt-8">
        <div class="site-meta-row">
          <time itemprop="datePublished" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>
          <a href={`${base}about`} rel="author" itemprop="author" class="site-link">
            By {siteConfig.founderName}
          </a>
        </div>
        <h1 id="article-top" tabindex="-1" itemprop="headline" class="site-page-title max-w-4xl">{post.data.title}</h1>
        <p itemprop="description" class="site-page-copy text-lg">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {post.data.tags.map((tag: string) => (
              <span class="site-chip site-chip-muted">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {post.data.youtubeId && (
        <div class="site-card mb-12 overflow-hidden">
          <div class="site-card-media aspect-video">
            <YouTube
              id={post.data.youtubeId}
              class="m-0 w-full aspect-video"
              poster="maxresdefault"
            />
          </div>
        </div>
      )}

      {sections.length >= 2 && <div class="article-page_contents-rail"><details data-pagefind-ignore class="article-page_contents"><summary class="article-page_contents-toggle"><Icon name="mdi:format-list-bulleted" class="size-5" /><span id="article-contents-title">On this page</span><Icon name="mdi:chevron-down" class="size-4" /></summary><nav aria-labelledby="article-contents-title" class="article-page_contents-nav"><div class="article-page_contents-track" aria-hidden="true"><span></span></div><ul class="article-page_contents-list">{contents.map(({slug, text, children}) => <li data-contents-section={slug}><a href={`#${slug}`} data-contents-link class="article-page_contents-link">{text}</a>{children.length > 0 && <ul class="article-page_contents-children">{children.map(child => <li><a href={`#${child.slug}`} data-contents-link class="article-page_contents-link">{child.text}</a></li>)}</ul>}</li>)}</ul></nav></details></div>}

      <div id="article-body"
        class="typeset typeset-blog"
      >
        <Content />
      </div>

    </div>
  </article>
</BaseLayout>

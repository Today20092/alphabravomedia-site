---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../../styles/blog.css";
const base = import.meta.env.BASE_URL;
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Video guides & editing notes | Alpha Bravo Media" description="Practical video guides, DaVinci Resolve workflows, exposure tools, and notes from the creative process at Alpha Bravo Media.">
  <section class="blog-index proto-section">
    <header class="blog-heading">
      <p class="proto-byline">The journal / Alpha Bravo Media</p>
      <h1>Notes from the edit.</h1>
      <p class="proto-intro">Video guides, editing workflows, and experiments worth sharing. Written by Ayoub.</p>
    </header>
    <div class="blog-list">
      {posts.map(post => (
        <a href={`${base}blog/${post.id}`} class="blog-entry">
          <div class="blog-entry-media">
            {post.data.image ? <Image src={post.data.image} alt={post.data.title} loading="lazy" /> : post.data.youtubeId ? <img src={`https://img.youtube.com/vi/${post.data.youtubeId}/maxresdefault.jpg`} alt={post.data.title} loading="lazy" width="1280" height="720" /> : <span class="blog-entry-placeholder">Field notes</span>}
          </div>
          <div>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time>
            {post.data.youtubeId && <span class="blog-video-label"> / With video</span>}
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="blog-read">Read the guide <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
    {posts.length === 0 && <p>No articles yet. Check back soon.</p>}
  </section>
</BaseLayout>

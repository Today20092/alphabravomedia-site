---
import { siteConfig } from "../site-config";
const base = import.meta.env.BASE_URL;
const links = [ ["", "Home"], ["blog", "Blog"], ["resources", "Resources"], ["gear", "Gear"], ["about", "About"] ];
const channel = siteConfig.socialLinks.find(link => link.platform === "youtube")!;
---
<a class="proto-skip" href="#main-content">Skip to content</a>
<header class="proto-nav channel-header">
  <a class="proto-brand" href={base} aria-label="Alpha Bravo Media home">alpha bravo<span>media</span></a>
  <a class="channel-button" href={channel.href}>Watch on YouTube ↗</a>
  <nav aria-label="Main navigation">
    {links.map(([path, label]) => <a href={`${base}${path}`} aria-current={Astro.url.pathname.replace(/\/$/, "") === `${base}${path}`.replace(/\/$/, "") ? "page" : undefined}>{label}</a>)}
  </nav>
</header>

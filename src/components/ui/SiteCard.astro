---
import { cn } from "@/lib/utils";

interface Props {
  href?: string;
  interactive?: boolean;
  class?: string;
}

const { href, interactive = false, class: className } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class={cn(
    "group/card flex flex-col overflow-hidden rounded-[min(var(--radius-4xl),24px)] border border-border bg-card text-card-foreground shadow-sm ring-1 ring-foreground/5",
    interactive &&
      "transition-all duration-200 hover:border-site-border-strong hover:bg-muted hover:shadow-site-sm focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/30",
    className,
  )}
>
  <slot />
</Tag>

---
import { cn } from "@/lib/utils";

interface Props {
  muted?: boolean;
  class?: string;
}

const { muted = false, class: className } = Astro.props;
---

<div
  class={cn(
    "relative rounded-lg border border-border text-card-foreground shadow-sm",
    muted ? "bg-muted" : "bg-card",
    className,
  )}
>
  <slot />
</div>

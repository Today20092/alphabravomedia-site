---
import SearchModal from "../components/SearchModal.astro";
import ChannelHeader from "../components/ChannelHeader.astro";
import ChannelFooter from "../components/ChannelFooter.astro";
import "../styles/channel.css";
import LinkButton from "../components/ui/LinkButton.astro";
import { buttonVariants } from "../components/ui/button";
import { SEO } from "astro-seo";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import { cn } from "../lib/utils";
import { siteConfig } from "../site-config";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  author?: string;
  publishedTime?: string;
  noIndex?: boolean;
}

const youtubeLink = siteConfig.socialLinks.find(
  (s) => s.platform === "youtube",
);

const {
  title = `${siteConfig.siteName} | Video guides and equipment notes`,
  description = "Video guides, editing workflows, practical tools, and equipment notes from Alpha Bravo Media.",
  canonical,
  ogImage = "/alpha-bravo-logo.svg",
  ogImageAlt = `${siteConfig.siteName} logo`,
  ogType = "website",
  author = siteConfig.founderName,
  publishedTime,
  noIndex = false,
} = Astro.props;

// Base URL for GitHub Pages (or '/' for custom domain)
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const siteOrigin = Astro.site ?? new URL(siteConfig.siteUrl);

function toAbsoluteUrl(value: string) {
  try {
    return new URL(value).toString();
  } catch {
    return new URL(value, siteOrigin).toString();
  }
}

const navLinks = [
  { href: base, label: "Home" },
  { href: `${base}services`, label: "Services" },
  { href: `${base}portfolio`, label: "Work" },
  { href: `${base}blog`, label: "Blog" },
  { href: `${base}gallery`, label: "Gallery" },
  { href: `${base}gear`, label: "Gear" },
  { href: `${base}contact`, label: "Contact" },
];

const currentPath = Astro.url.pathname;
const canonicalUrl = toAbsoluteUrl(canonical ?? Astro.url.pathname);
const ogImageUrl = toAbsoluteUrl(ogImage);
const seoMeta = [
  { name: "generator", content: Astro.generator },
  { name: "author", content: author },
  { name: "theme-color", content: "#110f0d" },
];
const iconButtonClass = cn(buttonVariants({ variant: "outline", size: "icon-lg" }), "rounded-full");
const searchButtonClass = cn(
  buttonVariants({ variant: "outline", size: "lg" }),
  "hidden rounded-full md:inline-flex",
);
const themeButtonClass = cn(
  buttonVariants({ variant: "secondary", size: "lg" }),
  "site-theme-toggle hidden rounded-full md:inline-flex",
);
const mobileThemeButtonClass = cn(
  buttonVariants({ variant: "secondary", size: "lg" }),
  "site-theme-toggle flex w-full justify-start rounded-full",
);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO
      charset="UTF-8"
      title={title}
      description={description}
      canonical={canonicalUrl}
      noindex={noIndex}
      robotsExtras={noIndex ? "nosnippet" : undefined}
      openGraph={{
        basic: {
          title,
          type: ogType,
          image: ogImageUrl,
          url: canonicalUrl,
        },
        optional: {
          description,
          siteName: siteConfig.siteName,
        },
        image: {
          alt: ogImageAlt,
        },
        article:
          ogType === "article"
            ? {
                authors: [author],
                publishedTime,
              }
            : undefined,
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: ogImageUrl,
        imageAlt: ogImageAlt,
      }}
      extend={{
        meta: seoMeta,
      }}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
    <script is:inline>
      (() => {
        const storageKey = "abm-theme";
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";

        let storedTheme = null;
        try {
          const value = localStorage.getItem(storageKey);
          if (value === "dark" || value === "light") {
            storedTheme = value;
          }
        } catch {
          storedTheme = null;
        }

        const theme = storedTheme ?? systemTheme;
        root.dataset.theme = theme;
        root.classList.toggle("dark", theme === "dark");
        root.style.colorScheme = theme;
        if (meta) {
          meta.setAttribute("content", theme === "dark" ? "#110f0d" : "#f4efe7");
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="revamp-prototype variant-A antialiased">
    <ChannelHeader />

    <!-- Main Content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <ChannelFooter />

    <SearchModal />

    <!-- Scripts -->
    <script>
      type SiteTheme = "dark" | "light";
      type AbmWindow = Window &
        typeof globalThis & {
          __abmThemeChangeHandler?: (event: MouseEvent) => void;
          __abmThemeMediaQuery?: MediaQueryList;
          __abmThemeMediaHandler?: () => void;
          __abmRevealObserver?: IntersectionObserver | null;
        };

      const abmWindow = window as AbmWindow;
      let lastScrollY = window.scrollY;
      const themeStorageKey = "abm-theme";
      const themeColors: Record<SiteTheme, string> = {
        dark: "#110f0d",
        light: "#f4efe7",
      };

      function handleScroll() {
        const header = document.querySelector("header");
        if (!header) return;

        const currentScrollY = window.scrollY;

        // Only hide header if scrolled down past 100px
        if (currentScrollY > lastScrollY && currentScrollY > 100) {
          header.style.transform = "translateY(-100%)";
        } else {
          header.style.transform = "translateY(0)";
        }
        lastScrollY = currentScrollY;
      }

      function getStoredTheme(): SiteTheme | null {
        try {
          const value = localStorage.getItem(themeStorageKey);
          if (value === "dark" || value === "light") return value;
        } catch {
          return null;
        }

        return null;
      }

      function getSystemTheme(): SiteTheme {
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }

      function applyTheme(theme: SiteTheme) {
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');

        root.dataset.theme = theme;
        root.classList.toggle("dark", theme === "dark");
        root.style.colorScheme = theme;

        if (meta) {
          meta.setAttribute("content", themeColors[theme]);
        }

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");

          const label = button.querySelector("[data-theme-label]");
          if (label) {
            label.textContent = theme === "dark" ? "Dark theme" : "Light theme";
          }
        });
      }

      function setupThemeToggle() {
        applyTheme(getStoredTheme() ?? getSystemTheme());

        if (abmWindow.__abmThemeChangeHandler) {
          document.removeEventListener("click", abmWindow.__abmThemeChangeHandler);
        }

        abmWindow.__abmThemeChangeHandler = (event: MouseEvent) => {
          if (!(event.target instanceof Element)) return;
          const button = event.target.closest("[data-theme-toggle]");
          if (!button) return;

          event.preventDefault();

          const currentTheme =
            document.documentElement.dataset.theme === "light" ? "light" : "dark";
          const nextTheme = currentTheme === "dark" ? "light" : "dark";

          try {
            localStorage.setItem(themeStorageKey, nextTheme);
          } catch {
            // Ignore storage failures and keep the current theme in memory.
          }

          applyTheme(nextTheme);
        };

        document.addEventListener("click", abmWindow.__abmThemeChangeHandler);

        if (abmWindow.__abmThemeMediaQuery && abmWindow.__abmThemeMediaHandler) {
          abmWindow.__abmThemeMediaQuery.removeEventListener(
            "change",
            abmWindow.__abmThemeMediaHandler,
          );
        }

        abmWindow.__abmThemeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        abmWindow.__abmThemeMediaHandler = () => {
          if (!getStoredTheme()) {
            applyTheme(getSystemTheme());
          }
        };
        abmWindow.__abmThemeMediaQuery.addEventListener(
          "change",
          abmWindow.__abmThemeMediaHandler,
        );
      }

      function setupInteractions() {
        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuOpen = document.getElementById("menu-open");
        const menuClose = document.getElementById("menu-close");

        mobileMenuBtn?.addEventListener("click", () => {
          const isHidden = mobileMenu?.classList.contains("hidden");

          if (isHidden) {
            mobileMenu?.classList.remove("hidden");
            menuOpen?.classList.add("hidden");
            menuClose?.classList.remove("hidden");
            mobileMenuBtn.setAttribute("aria-expanded", "true");
          } else {
            mobileMenu?.classList.add("hidden");
            menuOpen?.classList.remove("hidden");
            menuClose?.classList.add("hidden");
            mobileMenuBtn.setAttribute("aria-expanded", "false");
          }
        });

        // Setup Header transition
        const header = document.querySelector("header");
        if (header) {
          header.style.transition = "transform 0.3s ease-in-out";
        }

        // Header scroll behavior
        lastScrollY = window.scrollY;
        window.removeEventListener("scroll", handleScroll);
        window.addEventListener("scroll", handleScroll, { passive: true });

        // Handle contact highlight without causing page reload/transitions
        const contactLinks = document.querySelectorAll('a[href$="#contact"]');
        contactLinks.forEach((link) => {
          link.addEventListener("click", () => {
            const targets = document.querySelectorAll(
              ".contact-highlight-target",
            );
            targets.forEach((el) => {
              el.classList.remove("highlight-glow-animation");
              void (el as HTMLElement).offsetWidth; // trigger reflow
              el.classList.add("highlight-glow-animation");
            });

            setTimeout(() => {
              targets.forEach((el) =>
                el.classList.remove("highlight-glow-animation"),
              );
            }, 3000);
          });
        });

        setupRevealAnimations();
      }

      function setupRevealAnimations() {
        if (abmWindow.__abmRevealObserver) {
          abmWindow.__abmRevealObserver.disconnect();
          abmWindow.__abmRevealObserver = null;
        }

        const revealNodes = document.querySelectorAll("[data-reveal]");
        if (!revealNodes.length) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          revealNodes.forEach((node) => {
            node.classList.remove("site-reveal-pending");
            node.classList.add("site-reveal-in");
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("site-reveal-in");
              observer.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px -12% 0px",
            threshold: 0.18,
          },
        );

        abmWindow.__abmRevealObserver = observer;

        revealNodes.forEach((node) => {
          if (node.classList.contains("site-reveal-in")) return;
          node.classList.add("site-reveal-pending");
          observer.observe(node);
        });
      }

      // Run on initial load and after view transitions
      setupThemeToggle();
      document.addEventListener("astro:page-load", setupInteractions);
      document.addEventListener("astro:page-load", setupThemeToggle);
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  @keyframes contact-glow-pulse {
    0% {
      background-color: transparent;
      box-shadow: inset 0 0 0 0px color-mix(in oklab, var(--site-accent) 0%, transparent);
    }
    15% {
      background-color: var(--site-accent-soft);
      box-shadow:
        inset 0 0 0 1px color-mix(in oklab, var(--site-accent) 26%, transparent),
        inset 0 18px 30px -24px color-mix(in oklab, var(--site-accent) 20%, transparent);
    }
    85% {
      background-color: var(--site-accent-soft);
      box-shadow:
        inset 0 0 0 1px color-mix(in oklab, var(--site-accent) 26%, transparent),
        inset 0 18px 30px -24px color-mix(in oklab, var(--site-accent) 20%, transparent);
    }
    100% {
      background-color: transparent;
      box-shadow: inset 0 0 0 0px color-mix(in oklab, var(--site-accent) 0%, transparent);
    }
  }

  .highlight-glow-animation {
    animation: contact-glow-pulse 2.5s cubic-bezier(0.34, 1.56, 0.64, 1)
      forwards;
  }
</style>
